-- ==========================================
-- EXPERIMENT 1: STAR SCHEMA
-- BANK CUSTOMER CHURN SYSTEM
-- ==========================================

-- DROP TABLES
DROP TABLE IF EXISTS FACT_CUSTOMER_CHURN;
DROP TABLE IF EXISTS DIM_CUSTOMER;
DROP TABLE IF EXISTS DIM_GEOGRAPHY;
DROP TABLE IF EXISTS DIM_GENDER;


-- 1. CUSTOMER DIMENSION
CREATE TABLE DIM_CUSTOMER (
    Customer_Key INT PRIMARY KEY,
    CustomerId INT,
    Surname VARCHAR(100)
);


-- 2. GEOGRAPHY DIMENSION
CREATE TABLE DIM_GEOGRAPHY (
    Geography_Key INT PRIMARY KEY,
    Geography VARCHAR(100)
);


-- 3. GENDER DIMENSION
CREATE TABLE DIM_GENDER (
    Gender_Key INT PRIMARY KEY,
    Gender VARCHAR(20)
);


-- 4. FACT TABLE
CREATE TABLE FACT_CUSTOMER_CHURN (
    Churn_Fact_ID INT PRIMARY KEY,

    Customer_Key INT,
    Geography_Key INT,
    Gender_Key INT,

    Credit_Score INT,
    Age INT,
    Tenure INT,
    Balance NUMERIC(12, 2),
    Num_Of_Products INT,
    Has_Cr_Card INT,
    Is_Active_Member INT,
    Estimated_Salary NUMERIC(12, 2),
    Exited INT,

    FOREIGN KEY (Customer_Key)
        REFERENCES DIM_CUSTOMER(Customer_Key),

    FOREIGN KEY (Geography_Key)
        REFERENCES DIM_GEOGRAPHY(Geography_Key),

    FOREIGN KEY (Gender_Key)
        REFERENCES DIM_GENDER(Gender_Key)
);
